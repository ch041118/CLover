# New install: python setup_env.py generates JWT_SECRET and DATA_KEY.
JWT_SECRET=
DATA_KEY=
APP_ENV=development
DATABASE_URL=sqlite:///./care.db
# disabled: human/rules only; local: Qwen2.5 0.5B on this machine
LLM_MODE=disabled
LOCAL_MODEL=qwen2.5:0.5b
LOCAL_MODEL_URL=http://127.0.0.1:11434
# Set true only after using the cloud-disabled launcher and reviewing local security.
LOCAL_PRIVACY_REVIEWED=false
CORS_ORIGINS=["http://localhost:3000"]

# Optional offline speech recognition (install requirements-speech.txt first)
SPEECH_ENABLED=false
SPEECH_MODEL_PATH=./models/whisper-tiny
